#!/usr/bin/env bash
# Tell the machine to stay awake: toggles a transient systemd user unit
# holding a logind block lock on sleep and lid-close. The unit is the
# single source of truth (no daemon or config state to desync) and dies on
# reboot/logout, so normal sleep behavior always comes back on its own.
# The GNOME extension in this repo drives the same unit.
#
# `nosleep screen ...` toggles a second unit (nosleep-screen.service) that
# holds a GNOME idle inhibitor via gnome-session-inhibit, so the screen
# won't blank or lock — the same unit the extension's "Keep Screen On"
# toggle drives. (A logind idle lock would not stop GNOME blanking the
# screen; only a GNOME session inhibitor does, hence gnome-session-inhibit.)
set -euo pipefail

duration_re='^[0-9]+(\.[0-9]+)?[smhd]?$'
# A zero-length duration passes duration_re but makes the inner `sleep` exit at
# once, releasing the inhibitor while we'd report "on"; reject it too.
zero_re='^0+(\.0+)?[smhd]?$'

# Target selection: `nosleep screen ...` retargets every verb below to the
# screen/idle inhibitor; otherwise we drive the sleep inhibitor. Each target
# is the same unit its Quick Settings toggle drives, so CLI and extension
# stay interchangeable.
if [ "${1:-}" = screen ]; then
  shift
  target="screen"
  unit=nosleep-screen.service
  unit_name=nosleep-screen
  description="Hold idle inhibitor (nosleep)"
  inhibit=(gnome-session-inhibit --inhibit=idle --app-id=nosleep
           --reason="user asked to keep the screen on")
  label="screen "
else
  target="sleep"
  unit=nosleep.service
  unit_name=nosleep
  description="Hold sleep/lid-switch inhibitor (nosleep)"
  inhibit=(systemd-inhibit --what=sleep:handle-lid-switch --mode=block
           --who=nosleep --why="user asked the machine to stay awake")
  label=""
fi

active() {
  systemctl --user --quiet is-active "$unit"
}

start() {
  local duration="${1:-infinity}"
  # Validate before systemd-run: an invalid or zero-length duration would let
  # the inner `sleep` exit immediately, releasing the inhibitor while we report
  # success.
  if [ "$duration" != infinity ] &&
     { ! [[ "$duration" =~ $duration_re ]] || [[ "$duration" =~ $zero_re ]]; }; then
    echo "nosleep: invalid duration '$duration'" >&2
    exit 2
  fi
  # The screen inhibitor needs GNOME; fail clearly rather than via systemd-run
  if [ "$target" = screen ] && ! command -v gnome-session-inhibit >/dev/null; then
    echo "nosleep: gnome-session-inhibit not found (needs a GNOME session)" >&2
    exit 1
  fi
  # Replace any running instance so a new duration takes effect
  systemctl --user stop "$unit" 2>/dev/null || true
  # systemd-run returns once the unit has *started*, not once the inhibitor
  # command proves itself (it and the inner `sleep` resolve in the unit's own
  # environment, not ours). And `stop` can return before systemd has GC'd the
  # old unit, so a same-name start can briefly lose to "unit already exists" —
  # retry once.
  local attempt
  for attempt in 1 2; do
    if systemd-run --user --quiet --collect --unit="$unit_name" \
         --description="$description" \
         "${inhibit[@]}" \
         sleep "$duration"; then
      break
    elif [ "$attempt" = 2 ]; then
      echo "nosleep: failed to start ${label}inhibitor" >&2
      exit 1
    fi
    sleep 0.2
  done
  # A broken inhibitor (missing binary, or no reachable GNOME session over SSH)
  # exits at once; give it a beat, then confirm it is really holding rather than
  # printing a false "on".
  sleep 0.2
  if ! active; then
    echo "nosleep: ${label}inhibitor failed to start (is its command available?)" >&2
    exit 1
  fi
  if [ "$duration" = infinity ]; then
    echo "nosleep: ${label}on (until 'nosleep ${label}off')"
  else
    echo "nosleep: ${label}on for $duration"
  fi
}

stop() {
  if active; then
    systemctl --user stop "$unit"
    echo "nosleep: ${label}off"
  else
    echo "nosleep: ${label}already off"
  fi
}

status() {
  if active; then
    echo "nosleep: ${label}on (since $(systemctl --user show "$unit" --property=ActiveEnterTimestamp --value))"
  else
    echo "nosleep: ${label}off"
  fi
}

cmd="${1:-toggle}"
case "$cmd" in
  on) start "${2:-}" ;;
  off) stop ;;
  status) status ;;
  toggle) if active; then stop; else start; fi ;;
  *)
    if [[ "$cmd" =~ $duration_re ]]; then
      start "$cmd"
    else
      echo "usage: nosleep [screen] [on [duration] | off | status | <duration>]   e.g. 'nosleep 2h', 'nosleep screen on'" >&2
      exit 2
    fi
    ;;
esac
